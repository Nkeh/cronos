{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"],
    "outDir": "./node_modules/.tsbuild-node"
  },
  "include": ["vite.config.ts", "vitest.config.ts"]
}
