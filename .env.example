# ---- Core ----
ENV=development
LOG_LEVEL=INFO
PUBLIC_ORIGIN=http://localhost:8080
# Dev placeholder values below are deliberately obvious so the production guard
# (backend/app/core/config.py) can detect and refuse them when ENV=production.
SECRET_KEY=change-me-dev-only-not-for-production
ENCRYPTION_KEY=change-me-dev-only-not-for-production

# ---- Database (Postgres is the clock and the queue; source of truth) ----
POSTGRES_USER=cronos
POSTGRES_PASSWORD=cronos_dev_password
POSTGRES_DB=cronos
POSTGRES_TEST_DB=cronos_test
DATABASE_URL=postgresql+asyncpg://cronos:cronos_dev_password@db:5432/cronos
DATABASE_URL_TEST=postgresql+asyncpg://cronos:cronos_dev_password@db:5432/cronos_test

# ---- Redis (non-critical: rate limits and caches only, fail-open) ----
REDIS_URL=redis://redis:6379/0
# A dedicated, non-zero database index — tests flush this on every run, which
# would wipe real dev state if it ever pointed at db 0.
REDIS_URL_TEST=redis://redis:6379/15

# ---- Email (Mailpit locally; Postmark/Resend in prod, Day 14) ----
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_FROM=alerts@cronos.local
EMAIL_USE_TLS=false

# ---- Auth (Day 3) ----
# The production guard refuses to start the app when ENV=production and this is false.
COOKIE_SECURE=false
# Caddy's pinned address on the `default` network (see compose.yaml) — the
# only peer uvicorn trusts to set X-Forwarded-For, and the only peer the
# app's own rate-limiting re-check (TRUSTED_PROXY_IPS) trusts either.
FORWARDED_ALLOW_IPS=172.28.89.10
TRUSTED_PROXY_IPS=172.28.89.10
# Dev/test-only cheap argon2 params — never set these in production; the app
# falls back to argon2-cffi's real library defaults when they're unset.
ARGON2_TIME_COST=1
ARGON2_MEMORY_COST=8192
ARGON2_PARALLELISM=1

# ---- Dev-only rate-limit overrides (Day 5b) ----
# Production never sets these, so the coded defaults in Settings stay the real posture there.
# Raised ~4x over the coded defaults (not 20x, as a first pass here briefly had it) — enough
# headroom for several repeated local Playwright runs an hour without a real request ever seeing
# a 429, while staying small enough that pytest's own loop-to-the-limit rate-limit tests
# (tests/auth/test_login.py, test_rate_limit.py — they loop `settings.rate_limit_*_max` times)
# stay fast and don't risk tripping Redis's fail-open circuit breaker under load, which the 20x
# value did (two tests flaked once as 401 instead of 429 after ~200 sequential argon2 logins).
RATE_LIMIT_SIGNUP_IP_MAX=20
RATE_LIMIT_LOGIN_IP_MAX=40
RATE_LIMIT_RESET_REQUEST_EMAIL_MAX=12
RATE_LIMIT_RESET_REQUEST_IP_MAX=40

# ---- Alerts / external watchdog (wired up Day 14) ----
# Production defaults to 3 real connectivity-check endpoints (see backend/app/core/config.py);
# dev points at 3 distinct chaos paths instead (each defaults to "up" until flipped via
# POST /_control) so the canary-degraded live test (docs/progress/day-08.md) can flip 2 of 3
# down without touching any real monitor's path.
CANARY_URLS=http://chaos:8000/canary-1,http://chaos:8000/canary-2,http://chaos:8000/canary-3
WATCHDOG_URL=

# ---- Observability ----
SENTRY_DSN=

# ---- Payment seam (v1 has no billing; keys reserved, unused) ----
STRIPE_SECRET_KEY=unused
STRIPE_WEBHOOK_SECRET=unused

# ---- Dev-only SSRF escape hatch, lets the runner reach the chaos service ----
# The production guard refuses to start the app when ENV=production and this is set.
SSRF_ALLOW_HOSTS=chaos

# ---- Dev-only notifier/flapping overrides (Day 9) ----
# Production never sets these; the coded defaults (1m/5m/15m/1h backoff, 30/30min flap windows)
# stay the real posture there. Shortened here purely so a live/Playwright session can observe a
# full retry sequence, a lease expiry, and a flap enter/exit inside a few seconds instead of
# waiting out the real schedule.
NOTIFIER_LEASE_SECONDS=10
NOTIFIER_BACKOFF_SECONDS=5,10,15,20
FLAP_WINDOW_MINUTES=1
FLAP_THRESHOLD=1
FLAP_STABLE_MINUTES=1
FLAPPING_SWEEP_INTERVAL_SECONDS=5
CHANNEL_VERIFY_RATE_LIMIT_MAX=20

# ---- Dev file watching ----
# Docker Desktop on Windows can't always deliver native FS change events across a
# bind mount; polling is slower but reliable. Drives both Vite's and uvicorn --reload's
# watchers.
WATCH_POLLING=true
