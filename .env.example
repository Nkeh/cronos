# ---- Core ----
ENV=development
LOG_LEVEL=INFO
PUBLIC_ORIGIN=http://localhost:8080
# Dev placeholder values below are deliberately obvious so the production guard
# (backend/app/core/config.py) can detect and refuse them when ENV=production.
SECRET_KEY=change-me-dev-only-not-for-production
ENCRYPTION_KEY=change-me-dev-only-not-for-production

# ---- Database (Postgres is the clock and the queue; source of truth) ----
POSTGRES_USER=cronos
POSTGRES_PASSWORD=cronos_dev_password
POSTGRES_DB=cronos
POSTGRES_TEST_DB=cronos_test
DATABASE_URL=postgresql+asyncpg://cronos:cronos_dev_password@db:5432/cronos
DATABASE_URL_TEST=postgresql+asyncpg://cronos:cronos_dev_password@db:5432/cronos_test

# ---- Redis (non-critical: rate limits and caches only, fail-open) ----
REDIS_URL=redis://redis:6379/0
# A dedicated, non-zero database index — tests flush this on every run, which
# would wipe real dev state if it ever pointed at db 0.
REDIS_URL_TEST=redis://redis:6379/15

# ---- Email (Mailpit locally; Postmark/Resend in prod, Day 14) ----
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_FROM=alerts@cronos.local
EMAIL_USE_TLS=false

# ---- Auth (Day 3) ----
# The production guard refuses to start the app when ENV=production and this is false.
COOKIE_SECURE=false
# Caddy's pinned address on the `default` network (see compose.yaml) — the
# only peer uvicorn trusts to set X-Forwarded-For, and the only peer the
# app's own rate-limiting re-check (TRUSTED_PROXY_IPS) trusts either.
FORWARDED_ALLOW_IPS=172.28.89.10
TRUSTED_PROXY_IPS=172.28.89.10
# Dev/test-only cheap argon2 params — never set these in production; the app
# falls back to argon2-cffi's real library defaults when they're unset.
ARGON2_TIME_COST=1
ARGON2_MEMORY_COST=8192
ARGON2_PARALLELISM=1

# ---- Alerts / external watchdog (wired up Day 14) ----
CANARY_URLS=https://example.com,https://www.wikipedia.org,https://www.cloudflare.com
WATCHDOG_URL=

# ---- Observability ----
SENTRY_DSN=

# ---- Payment seam (v1 has no billing; keys reserved, unused) ----
STRIPE_SECRET_KEY=unused
STRIPE_WEBHOOK_SECRET=unused

# ---- Dev-only SSRF escape hatch, lets the runner reach the chaos service ----
# The production guard refuses to start the app when ENV=production and this is set.
SSRF_ALLOW_HOSTS=chaos

# ---- Dev file watching ----
# Docker Desktop on Windows can't always deliver native FS change events across a
# bind mount; polling is slower but reliable. Drives both Vite's and uvicorn --reload's
# watchers.
WATCH_POLLING=true
